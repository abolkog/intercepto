{
  "name": "intercepto",
  "description": "Intercept API calls and mock their status code and response body, right in the browser.",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "workspaces": [
    "site"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abolkog/intercepto.git"
  },
  "bugs": {
    "url": "https://github.com/abolkog/intercepto/issues"
  },
  "homepage": "https://github.com/abolkog/intercepto#readme",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "dev:site": "npm run dev --workspace=site",
    "build:site": "npm run build --workspace=site"
  },
  "dependencies": {
